# copy to .env.local and fill in what you need. every value is optional:
# the site runs fine without them. the contact form just degrades to
# honeypot + rate-limiting and logs submissions server-side instead of emailing.

# contact form email delivery via resend.com (free tier).
# without RESEND_API_KEY, messages are validated + logged but not emailed.
RESEND_API_KEY=
CONTACT_TO=sunnypatel124555@gmail.com

# google recaptcha v3 on the contact form (optional bot protection).
# the site key is public and ships to the browser; the secret stays server-side.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
