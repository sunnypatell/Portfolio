# copy to .env.local and fill in. every value here is a PUBLIC client key (they all
# ship to the browser by design), so this is configuration, not secrets. restrict
# the keys at their source (firebase/emailjs consoles), not by hiding them.

# live user counter: firebase web api key for the public read-only stats document
NEXT_PUBLIC_FIREBASE_API_KEY=

# contact form delivery via emailjs (https://emailjs.com), all client-side public ids
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
